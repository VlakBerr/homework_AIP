#include <iostream>
#include <cmath>

struct Point {
	double x;
	double y;
};

double distance(Point a, Point b){
	double d;
	d = pow(pow((a.x - b.x), 2) + pow((a.y - b.y), 2), 0.5);
	return d;
}

int main() {
	int size;
	std::cout << "Enter size of array: ";
	std::cin >> size;
	if (std::cin.fail()) {
		std::cerr << "Wrong input!!!";
		return 1;
	}
	Point *arr = new Point[size];

	for (int i = 0; i < size; i++) {
		std::cout << "Enter x: ";
		std::cin >> arr[i].x;
		if (std::cin.fail()) {
			std::cerr << "Wrong input!!!";
			return 1;
		}
		std::cout << "Enter y: ";
		std::cin >> arr[i].y;
		if (std::cin.fail()) {
			std::cerr << "Wrong input!!!";
			return 1;
		}
		std::cout << std::endl;
	}

	double mx = 0;
	Point p1;
	Point p2;

	for (int i = 0; i < (size - 1); i++) {
		if (distance(arr[i], arr[i + 1]) > mx) {
			mx = distance(arr[i], arr[i + 1]);
			p1 = arr[i];
			p2 = arr[i + 1];
		}
	}

	std::cout << "Max distance: " << mx << std::endl;
	std::cout << "Point 1: (" << p1.x << ", " << p1.y << ")" << std::endl;
	std::cout << "Point 2: (" << p2.x << ", " << p2.y << ")" << std::endl;



	delete[] arr;
	return 0;
}






